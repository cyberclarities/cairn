# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is required — pick a strong random value (openssl rand -hex 24).
# The web container builds DATABASE_URL from these automatically via docker-compose.
POSTGRES_USER=cairn
POSTGRES_PASSWORD=
POSTGRES_DB=cairn

# Override only if pointing to an external Postgres instance instead of the
# container defined in docker-compose.yml.
# DATABASE_URL=postgresql://cairn:password@postgres/cairn

# ─── Hostname & Port ──────────────────────────────────────────────────────────
# Hostname Caddy serves TLS for — must match what users type in the browser.
# Use 'localhost' for local dev/testing.
SERVER_NAME=localhost
BASE_URL=https://localhost

# Internal Gunicorn port (never exposed to the host directly).
# Change only if 5000 conflicts on your host.
PORT=5000

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters and not a placeholder — the app
# refuses to start otherwise, because a weak key means forgeable sessions.
# Generate with: openssl rand -hex 32
SECRET_KEY=

# Session cookies are marked Secure by default (the app is served over TLS by
# Caddy). Set to false only when running plain HTTP locally.
SESSION_COOKIE_SECURE=true
# Idle session lifetime in minutes.
SESSION_LIFETIME_MINUTES=480

# Failed-login lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Maximum upload size in MB (database restore accepts .sql / .sql.gz).
MAX_UPLOAD_MB=512

# Run Alembic migrations automatically on startup. Set false to run
# `flask db upgrade` as an explicit deploy step instead.
AUTO_UPGRADE_DB=true

# Where pre-restore safety snapshots are written inside the container.
CAIRN_BACKUP_DIR=/app/data/pre-restore

# Where uploaded evidence files are written inside the container. Both this
# and CAIRN_BACKUP_DIR live under /app/data, which docker-compose.yml mounts
# as a persistent volume — change this only if you're moving the mount point.
EVIDENCE_STORAGE_PATH=/app/data/evidence

# Scheduled evidence integrity check. Every stored evidence file is re-hashed
# against its recorded SHA-256 on this interval, least-recently-checked first,
# EVIDENCE_VERIFY_BATCH files per run. Mismatches and missing files go to the
# audit log, the record's chain of custody, and the container log at ERROR.
# Downloads verify too, but they are admin-only and infrequent — this is what
# makes tamper detection independent of somebody clicking. Set HOURS=0 to
# disable (not recommended).
EVIDENCE_VERIFY_HOURS=24
EVIDENCE_VERIFY_BATCH=200

# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ─── Bootstrap Admin ──────────────────────────────────────────────────────────
# Used once on first start to create the admin account. Ignored on subsequent starts.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# Required on first start only, to create the initial admin account. CAIRN
# refuses to bootstrap without a real value — no default, because this account
# can download and restore the entire database. Generate one:
#   openssl rand -base64 24
ADMIN_PASSWORD=

# ─── Case / Evidence ID Prefixes ──────────────────────────────────────────────
# Set before first run. Changing after cases exist does not renumber existing records.
CASE_ID_PREFIX=INC
EVIDENCE_ID_PREFIX=EVD

# ─── SMTP (optional) ──────────────────────────────────────────────────────────
# Leave SMTP_HOST blank to disable all email notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cairn@example.com
SMTP_USE_TLS=true

# ─── Azure AD SSO (optional) ──────────────────────────────────────────────────
# Leave OIDC_CLIENT_ID blank to disable SSO. Local login always remains active.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Replace <tenant-id> with your Azure Directory (tenant) ID
OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration

# Azure AD group Object IDs → roles.
# At least one MUST be set for SSO to grant access — deny by default.
# Users not in a listed group are denied.
OIDC_ADMIN_GROUP=
OIDC_ANALYST_GROUP=
OIDC_VIEWER_GROUP=

# ─── CrowdStrike Falcon API (optional) ────────────────────────────────────────
# Leave CS_CLIENT_ID blank to disable automatic alert polling.
# Create an API client in Falcon Console → API Clients & Keys.
# Required scopes: Alerts (read)
CS_CLIENT_ID=
CS_CLIENT_SECRET=
# Base URL for your Falcon cloud region:
#   US-1: https://api.crowdstrike.com  (default)
#   US-2: https://api.us-2.crowdstrike.com
#   EU-1: https://api.eu-1.crowdstrike.com
#   GOV:  https://api.laggar.gcw.crowdstrike.com
CS_BASE_URL=https://api.crowdstrike.com
# Maximum alerts to pull per 15-minute poll cycle (max 500)
CS_POLL_LIMIT=200
# Seconds of history to pull on the very first poll, before a high-water mark
# exists — keep at 900 to match the 15-min scheduler. Only used once; after
# that the scheduler queries forward from the stored mark instead.
CS_POLL_WINDOW=900

# ─── Proofpoint TAP SIEM API (optional) ───────────────────────────────────────
# Leave PP_SERVICE_PRINCIPAL blank to disable Proofpoint alert polling.
# Generate credentials in Proofpoint TAP → Settings → Connected Applications.
PP_SERVICE_PRINCIPAL=
PP_API_SECRET=
# EU tenants use: https://tap-api-v2.proofpoint.com (same default, region is in the tenant URL)
PP_BASE_URL=https://tap-api-v2.proofpoint.com
# Seconds of history to pull per poll cycle — keep at 900 to match the 15-min scheduler
PP_POLL_WINDOW=900

# ─── Threat-intelligence lookups (all optional) ───────────────────────────────
# Nothing here polls. A lookup runs when an analyst asks for one, on the
# indicators they picked, and every attempt is written to the audit log as a
# disclosure. Leave a key blank and that provider does not appear.
#
# Read this before turning one on. Asking a provider about an indicator tells
# that provider you are interested in it; asking about a file hash tells them
# you are holding the sample. Against a targeted actor that can be the tip-off.
# CAIRN never uploads a file and never submits a URL for scanning — hashes and
# URLs are looked up against what the provider already holds. Private, reserved,
# loopback, link-local and multicast addresses are refused before a request is
# built, so internal addressing does not leave the building by accident.
#
# GreyNoise (community endpoint), urlscan.io (search) and CIRCL hashlookup
# answer without a key. A key raises the rate limit on the first two; CIRCL
# takes none at all and so has no line here.
#
# VirusTotal: https://www.virustotal.com/gui/my-apikey
# The free public key is 4 requests/minute, 500/day, and VirusTotal's terms
# exclude commercial use. Check the tier against how you are actually using it.
TI_VIRUSTOTAL_KEY=
# AbuseIPDB: https://www.abuseipdb.com/account/api
TI_ABUSEIPDB_KEY=
# Criminal IP: https://www.criminalip.io/mypage/information
TI_CRIMINALIP_KEY=
# GreyNoise: https://viz.greynoise.io/account — optional, raises the limit
TI_GREYNOISE_KEY=
# urlscan.io: https://urlscan.io/user/profile/ — optional, raises the limit
TI_URLSCAN_KEY=
# AlienVault OTX: https://otx.alienvault.com/api
TI_OTX_KEY=
